# Anthropic (Managed Agents)
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_ENVIRONMENT_ID=your_anthropic_environment_id
# Optional: read from claude-lock.json after `ant apply agents/coordinator.md`
COORDINATION_AGENT_ID=
FINANCE_AGENT_ID=
GENERAL_AGENT_ID=
# Spend cap per Managed Agents session, in US cents (integer). Default 100 = $1.00
SESSION_BUDGET_CENTS=100
# Start a fresh session (seeded with the last 3 messages) after this many idle
# minutes, once the prompt cache has expired. 0 disables it.
SESSION_IDLE_ROLLOVER_MINUTES=5

# Supabase (MCP database access, logging, conversation_sessions table)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_PROJECT_REF=your_supabase_project_ref
SUPABASE_ACCESS_TOKEN=your_supabase_access_token

# Finance database: queried through the Supabase MCP server (read_only=true)
# using SUPABASE_PROJECT_REF + SUPABASE_ACCESS_TOKEN above.

# Guardrails
NVIDIA_API_KEY=your_nvidia_api_key

# Currency: USD per 1 INR (e.g. 0.0118 = 84.75 INR per USD)
INR_TO_USD_RATE=0.0118
